# ==============================================================================
# NEXDO ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# DO NOT COMMIT REAL CREDENTIALS, SECRETS, OR PASSWORDS TO THIS FILE
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=3000
APP_BASE_URL=https://app.nexdo.in

# Supabase Production Database & API Configuration
# Client-accessible variables (Public / RLS-scoped anon key):
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your_public_anon_key_placeholder

# Server-only variables (NEVER expose to client bundle or git):
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your_public_anon_key_placeholder
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your_service_role_secret_key_placeholder
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Database Pool Configuration
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# Authentication & Session Security
SESSION_SECRET=your_cryptographically_secure_random_64_byte_hex_secret
SESSION_COOKIE_NAME=__Host-nexdo_session
SESSION_MAX_AGE_SECONDS=604800
CSRF_SECRET=your_csrf_hmac_secret_here

# Redis / Distributed Rate Limiting & Cache
REDIS_URL=redis://default:password@localhost:6379

# Payment Gateway (Razorpay / Cashfree / Sandbox)
PAYMENT_PROVIDER=RAZORPAY
PAYMENT_KEY_ID=rzp_live_placeholder_key_id
PAYMENT_KEY_SECRET=rzp_live_placeholder_key_secret
PAYMENT_WEBHOOK_SECRET=your_webhook_hmac_sha256_verification_secret

# Security & CORS Controls
CORS_ALLOWED_ORIGINS=https://app.nexdo.in,https://admin.nexdo.in
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300

# Telemetry & Monitoring (Optional)
SENTRY_DSN=
AUDIT_LOG_DESTINATION=database
